# Copy this file to .env and fill in your backend.
# Any OpenAI-compatible /v1/chat/completions endpoint works.

# --- Meshtastic connection (defaults are fine for meshtasticd on the same Pi) ---
MESHTASTIC_HOST=localhost
MESHTASTIC_PORT=4403

# Admin key (32 bytes, base64). Lets a remote Meshtastic node manage this node.
# Leave empty to disable remote administration.
MESHTASTIC_ADMIN_KEY=

# --- Radio / LoRa ---
# LoRa radio drop-in: a file under meshtasticd/config.d/lora-<name>.yaml, or a
# preset name from /etc/meshtasticd/available.d  (e.g. RAK13300-slot1).
LORA_RADIO_PRESET=RAK13300-slot1
# Meshtastic region; UNSET falls back to the radio default (US 915).
MESHTASTIC_REGION=UNSET
# Global LoRa modem preset shared by every channel (LONG_FAST, SHORT_FAST, ...).
LORA_MODEM_PRESET=LONG_FAST

# --- Channels ---
CHANNEL_0_NAME=LongFast
CHANNEL_0_PSK=                        # base64 32-byte key; empty keeps the default key
CHANNEL_0_UPLINK=false                # publish channel 0 to MQTT
CHANNEL_0_DOWNLINK=false              # receive from MQTT into channel 0
# Extra channels: "name:psk[:role]" entries separated by ';' (psk = base64 key).
# Example: CHANNELS_EXTRA=Work:AQIAAA1234...=SECONDARY
CHANNELS_EXTRA=

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# --- MQTT (disabled by default) ---
# Bridge the mesh to an MQTT broker over the Pi's internet connection.
MQTT_ENABLED=false
MQTT_ADDRESS=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ROOT=msh
MQTT_TLS_ENABLED=false
MQTT_ENCRYPTION_ENABLED=false
MQTT_JSON_ENABLED=false

# --- AI backend ---
# Default: a small local model served by Ollama on the same Pi (no cloud key).
AI_API_BASE=http://127.0.0.1:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen3.5:0.8b

# Pull it once:  ollama pull qwen3.5:0.8b
#
# Sized for your Pi 4B RAM. Confirm a tag with `ollama search <name>`:
#   2 GB:  qwen3.5:0.8b                   default (best starting point)
#   2 GB:  lfm2.5:1.2b-instruct           efficiency experiment
#   2 GB:  llama3.2:1b-instruct-q4_K_M    comparison model
#   4 GB:  qwen2.5:1.5b-instruct-q4_K_M   safe mature choice
#   4 GB:  qwen3:1.7b-instruct-q4_K_M     higher quality
#   8 GB:  qwen2.5:3b-instruct-q4_K_M     upper-end experiment

# Or a hosted OpenAI-compatible API instead:
# AI_API_BASE=https://api.openai.com/v1
# AI_API_KEY=sk-REPLACE_ME
# AI_MODEL=gpt-4o-mini

AI_SYSTEM_PROMPT=You answer over low-bandwidth mesh radio. Be accurate and concise.
AI_MAX_TOKENS=300
AI_TEMPERATURE=0.7

# --- Behavior ---
# Set to true to also answer channel-wide (broadcast) messages.
REPLY_TO_BROADCAST=false
# Meshtastic text payloads are small; replies longer than this are split.
REPLY_MAX_CHARS=180
