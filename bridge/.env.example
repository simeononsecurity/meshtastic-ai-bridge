# Copy this file to .env and fill in your backend.
# Any OpenAI-compatible /v1/chat/completions endpoint works.

# --- Meshtastic connection (defaults are fine for meshtasticd on the same Pi) ---
MESHTASTIC_HOST=localhost
MESHTASTIC_PORT=4403

# --- AI backend ---
# OpenAI:
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=sk-REPLACE_ME
AI_MODEL=gpt-4o-mini

# Local Ollama (no key needed):
# AI_API_BASE=http://127.0.0.1:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.1

# LM Studio / vLLM / text-generation-webui:
# AI_API_BASE=http://127.0.0.1:1234/v1
# AI_API_KEY=not-needed
# AI_MODEL=local-model

AI_SYSTEM_PROMPT=You answer over low-bandwidth mesh radio. Be accurate and concise.
AI_MAX_TOKENS=300
AI_TEMPERATURE=0.7

# --- Behavior ---
# Set to true to also answer channel-wide (broadcast) messages.
REPLY_TO_BROADCAST=false
# Meshtastic text payloads are small; replies longer than this are split.
REPLY_MAX_CHARS=180
