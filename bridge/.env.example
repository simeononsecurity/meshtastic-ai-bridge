# Copy this file to .env and fill in your backend.
# Any OpenAI-compatible /v1/chat/completions endpoint works.

# --- Meshtastic connection ---
# Three ways to connect, selected by MESHTASTIC_CONNECTION:
#   tcp  + MESHTASTIC_HOST=localhost  -> local meshtasticd daemon (default)
#   tcp  + MESHTASTIC_HOST=<ip>       -> a REMOTE Meshtastic node that exposes
#                                        its TCP API on port 4403 (e.g. an
#                                        ESP32 on your WiFi, or meshtasticd on
#                                        another machine)
#   serial + MESHTASTIC_SERIAL_PORT   -> a local standalone node over USB
#                                        (RAK4631 / RAK4630 / RAK19713)
MESHTASTIC_CONNECTION=tcp
MESHTASTIC_HOST=localhost
# TCP API port (4403 is the Meshtastic default for meshtasticd and WiFi nodes):
MESHTASTIC_PORT=4403
# USB CDC serial port of the node when MESHTASTIC_CONNECTION=serial:
MESHTASTIC_SERIAL_PORT=/dev/ttyACM0
MESHTASTIC_SHORT_NAME=BOT
MESHTASTIC_LONG_NAME=Mesh Assistant

# Example: point the bridge at a remote WiFi Meshtastic node instead of a local daemon:
# MESHTASTIC_CONNECTION=tcp
# MESHTASTIC_HOST=<node-ip>
# MESHTASTIC_PORT=4403

# Admin key (32 bytes, base64). Lets a remote Meshtastic node manage this node.
# Leave empty to disable remote administration.
MESHTASTIC_ADMIN_KEY=

# --- Radio / LoRa ---
# LoRa radio drop-in: a file under meshtasticd/config.d/lora-<name>.yaml, or a
# preset name from /etc/meshtasticd/available.d  (e.g. RAK13300-slot1).
LORA_RADIO_PRESET=RAK13300-slot1
# Meshtastic region; UNSET falls back to the radio default (US 915).
MESHTASTIC_REGION=UNSET
# Global LoRa modem preset shared by every channel (LONG_FAST, SHORT_FAST, ...).
LORA_MODEM_PRESET=LONG_FAST

# --- Channels ---
CHANNEL_0_NAME=LongFast
CHANNEL_0_PSK=                        # base64 32-byte key; empty keeps the default key
CHANNEL_0_UPLINK=false                # publish channel 0 to MQTT
CHANNEL_0_DOWNLINK=false              # receive from MQTT into channel 0
# Extra channels: "name:psk[:role]" entries separated by ';' (psk = base64 key).
# Example: CHANNELS_EXTRA=Work:AQIAAA1234...=SECONDARY
CHANNELS_EXTRA=

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# --- MQTT (disabled by default) ---
# Bridge the mesh to an MQTT broker over the Pi's internet connection.
MQTT_ENABLED=false
MQTT_ADDRESS=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ROOT=msh
MQTT_TLS_ENABLED=false
MQTT_ENCRYPTION_ENABLED=false
MQTT_JSON_ENABLED=false

# --- AI backend ---
# Default: a small local model served by Ollama on the same Pi (no cloud key).
AI_API_BASE=http://127.0.0.1:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen3.5:0.8b

# Pull it once:  ollama pull qwen3.5:0.8b
#
# Sized for your Pi 4B RAM. Confirm a tag with `ollama search <name>`:
#   2 GB:  qwen3.5:0.8b                   default (best starting point)
#   2 GB:  lfm2.5:1.2b-instruct           efficiency experiment
#   2 GB:  llama3.2:1b-instruct-q4_K_M    comparison model
#   4 GB:  qwen2.5:1.5b-instruct-q4_K_M   safe mature choice
#   4 GB:  qwen3:1.7b-instruct-q4_K_M     higher quality
#   8 GB:  qwen2.5:3b-instruct-q4_K_M     upper-end experiment

# Or a hosted OpenAI-compatible API instead:
# AI_API_BASE=https://api.openai.com/v1
# AI_API_KEY=sk-REPLACE_ME
# AI_MODEL=gpt-4o-mini

AI_SYSTEM_PROMPT=You answer over low-bandwidth mesh radio. Be accurate and concise.
AI_MAX_TOKENS=300
AI_TEMPERATURE=0.7

# --- Bot behavior ---
# Direct messages are answered. Channel broadcasts are answered only when they
# start with this prefix, e.g. "!bot weather <city>".
REPLY_TO_BROADCAST=true
BOT_PREFIX=!bot
# On-demand retrieval. Wiki requests prefer the optional local SQLite index,
# then fall back to the public Wikipedia API when enabled.
WEB_RETRIEVAL_ENABLED=true
LOCAL_WIKI_ENABLED=true
LOCAL_WIKI_INDEX=/opt/meshtastic-ai-bridge/data/wiki.sqlite3
LOCAL_KIWIX_ENABLED=true
LOCAL_KIWIX_URL=http://127.0.0.1:8766
KIWIX_BUNDLES=prompt
KIWIX_INTERACTIVE=true
KIWIX_MAX_DOWNLOAD_GB=4
KIWIX_DATA_DIR=/opt/meshtastic-ai-bridge/zim
# HTTP identity sent to Wikipedia, wttr.in, and Google News RSS.
HTTP_USER_AGENT=Local-Meshtastic-Assistant/1.0 (Meshtastic AI bridge)
# Optional private defaults. Leave blank to require a location/topic in the request.
DEFAULT_WEATHER_LOCATION=
DEFAULT_NEWS_TOPIC=
# Editable agent identity and safety policy.
AI_SYSTEM_PROMPT_FILE=/opt/meshtastic-ai-bridge/agent_prompt.txt
# Meshtastic text payloads are small; replies longer than this are split.
REPLY_MAX_CHARS=180
