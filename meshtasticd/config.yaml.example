# Optional meshtasticd settings.
#
# The package ships a complete, working default at /etc/meshtasticd/config.yaml.
# This file only documents the optional Web server, which you can merge into the
# default config to get the on-device status page. Most users do not need it.
#
#   cp config.yaml.example /etc/meshtasticd/config.yaml
#   sudo systemctl restart meshtasticd
#
Webserver:
  Port: 9443
  RootPath: "/usr/share/meshtasticd/web"
